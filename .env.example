# Copy this file to .env and fill in the values.

# --- Required for LIVE AI calls (browser web call) ---
# Vapi dashboard -> API Keys -> Public key
VAPI_PUBLIC_KEY=

# Public URL of this server so Vapi can call your tools (save details, book visit).
# Run:  ngrok http 3000   and paste the https URL here (no trailing slash)
PUBLIC_SERVER_URL=

# --- Branding / agent ---
FIRM_NAME=Prime Nest Realty
AGENT_NAME=Priya

# --- Voice AI settings (defaults work) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
VAPI_VOICE_ID=Clara
# "multi" understands English + Hindi mixing; use en-IN for English only
TRANSCRIBER_LANGUAGE=multi

# Hindi / Kannada calls (Azure voices via Vapi; change if Vapi's voice library shows a different id)
VOICE_HI=hi-IN-SwaraNeural
VOICE_KN=kn-IN-SapnaNeural

# Meta lead-ads webhook verification token (only needed if you connect a real Meta app)
META_VERIFY_TOKEN=demo-verify-token

# --- Optional: real outbound PHONE calls (try on Friday, not required) ---
# Vapi dashboard -> API Keys -> Private key, and Phone Numbers -> your number's id
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=

PORT=3000
